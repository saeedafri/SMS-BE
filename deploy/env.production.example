# Copy to /opt/relay/.env on the server, fill in, then: chmod 600 /opt/relay/.env
#
# deploy/install-server.sh generates the passwords into /opt/relay/.secrets and
# this file is assembled from them — you should not need to write one by hand.
# If you do, generate them ON the server, never by hand:
#   openssl rand -base64 32

CONTROL_API_ADDR=127.0.0.1:8080
LOG_LEVEL=info

# Loopback only. None of these ports is reachable from the internet, and these
# URLs are the second layer of that.
#
# Postgres is the EXISTING ems-postgres container on :5432, in its own `sms`
# database. Redis is Relay's own on :6380 — 6379 belongs to ems-redis.
DATABASE_URL=postgres://sms_app:REPLACE@127.0.0.1:5432/sms?sslmode=disable
DATABASE_ADMIN_URL=postgres://sms_migrator:REPLACE@127.0.0.1:5432/sms?sslmode=disable
REDIS_URL=redis://127.0.0.1:6380/0

# The credentials here are really used — OpenClickHouse reads the URL's
# userinfo. It used to ignore them and connect as the passwordless `default`
# user, which looks identical from the outside right up until it isn't.
CLICKHOUSE_URL=http://relay:REPLACE@127.0.0.1:8123/sms

JWT_SIGNING_KEY=REPLACE

# Transactional email (Resend). Leave RESEND_API_KEY empty to log instead of
# sending — that is the right setting for local development and CI, where
# nothing should be able to reach a real inbox.
#
# MAIL_FROM must be on a domain VERIFIED in Resend, or every send returns 422.
RESEND_API_KEY=
MAIL_FROM=Relay <relay@saqibsaeed.cloud>

# The FRONTEND's origin, not this API's. It builds the links inside those
# emails, and they have to land on the pages that read ?token= — pointing this
# at the API sends every recipient to a 404.
APP_BASE_URL=https://app.saqibsaeed.cloud

# Test hooks: /v1/dev/*. They are UNAUTHENTICATED by design (they fall back to
# the fixture tenant so Playwright's cookie-less `request` fixture can use
# them), and one of them rebuilds the whole demo dataset. Leave this off unless
# the deployment is a demo box whose nginx also returns 403 for /v1/dev/.
ENABLE_DEV_ENDPOINTS=false
