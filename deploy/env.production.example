# Copy to /opt/relay/.env on the server, fill in, then: chmod 600 /opt/relay/.env
#
# Generate the passwords on the server, never by hand:
#   openssl rand -base64 32

CONTROL_API_ADDR=127.0.0.1:8080
LOG_LEVEL=info

# Loopback only. These must never be reachable from the internet — the firewall
# blocks 5432/6379/9000, and these URLs are the second layer of that.
DATABASE_URL=postgres://sms_app:REPLACE@127.0.0.1:5432/sms?sslmode=disable
DATABASE_ADMIN_URL=postgres://sms_migrator:REPLACE@127.0.0.1:5432/sms?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379/0
CLICKHOUSE_URL=http://127.0.0.1:8123/sms
