# /opt/relay-test/api.env on the server: the API container's settings.
# chmod 600. Generate every secret ON the server, never by hand:
#   openssl rand -hex 32
#
# The datastores are the compose services, reached by name on the compose
# network. Their passwords are in /opt/relay-test/.env (PG_SUPERUSER_PASSWORD,
# CLICKHOUSE_PASSWORD, SMS_APP_PASSWORD, SMS_MIGRATOR_PASSWORD).

CONTROL_API_ADDR=:8080
LOG_LEVEL=info

DATABASE_URL=postgres://sms_app:REPLACE@postgres:5432/sms?sslmode=disable
DATABASE_ADMIN_URL=postgres://sms_migrator:REPLACE@postgres:5432/sms?sslmode=disable
REDIS_URL=redis://redis:6379/0

# The credentials here are really used — OpenClickHouse reads the URL's
# userinfo. The native port is derived as host:9000 from this URL.
CLICKHOUSE_URL=http://relay:REPLACE@clickhouse:8123/sms

JWT_SIGNING_KEY=REPLACE

# Transactional email (Resend). Leave RESEND_API_KEY empty to log instead of
# sending — that is the right setting for local development and CI, where
# nothing should be able to reach a real inbox.
#
# MAIL_FROM must be on a domain VERIFIED in Resend, or every send returns 422.
# Unquoted: docker compose reads this file literally.
MAIL_FROM=Relay <relay@…>` aborts with a syntax error and takes
# the migration step down with it.
RESEND_API_KEY=
MAIL_FROM=Relay <relay@saqibsaeed.cloud>

# The FRONTEND's origin, not this API's. It builds the links inside those
# emails, and they have to land on the pages that read ?token= — pointing this
# at the API sends every recipient to a 404.
# app.saqibsaeed.cloud has no DNS record and never has — it was aspirational,
# and anyone who copied this file verbatim sent every verification and reset
# link to a host that does not resolve. The live frontend is the Vercel
# deployment; change this the day a custom domain actually points somewhere.
APP_BASE_URL=https://sms-platform-frontend-nine.vercel.app

# Test hooks: /v1/dev/*. They are UNAUTHENTICATED by design (they fall back to
# the fixture tenant so Playwright's cookie-less `request` fixture can use
# them), and one of them rebuilds the whole demo dataset. Leave this off unless
# the deployment is a demo box whose nginx also returns 403 for /v1/dev/.
# A real production deployment says so; the API then refuses to start with
# ENABLE_DEV_ENDPOINTS on. The Hostinger server is a test environment and
# leaves APP_ENV unset.
APP_ENV=
ENABLE_DEV_ENDPOINTS=false

# Restricts /v1/operator to known networks: addresses or CIDRs, comma
# separated. Empty means the operator console — which sees every customer — is
# reachable from the entire internet behind one password. Set it to the office
# egress or the VPN range.
OPERATOR_IP_ALLOWLIST=

# Permits enabling a route whose compliance standing is grey: traffic that
# reaches handsets without being registered with the operator behind it. It
# delivers until the carrier notices, and then messages are filtered with no
# report and the customer's sender id is blocked. Leave this off.
ALLOW_GREY_ROUTES=false

# ---- SMPP operator binds -------------------------------------------------
# Encrypts every operator bind password at rest: base64 of 32 random bytes
# (openssl rand -base64 32). Empty means no connection can be created or
# enabled. Changing it makes every stored password unreadable, so set it once
# and re-enter the bind passwords if it is ever rotated.
CONNECTION_ENCRYPTION_KEY=

# Which connections this server dials: live or test. Default live. A staging
# box sharing the database must say test, or two servers bind the same
# operator account.
SMPP_ENVIRONMENT=live

# Every DLT telemarketer id between a principal entity and the operator, comma
# separated, ending with the telemarketer that hands messages to the operator
# (us). It feeds the chain-hash TLV; empty omits the TLV and DLT scrubbing
# refuses every Indian message. Example: 1702160102377279508
DLT_TM_CHAIN=

# Peers whose X-Real-IP is believed, as CIDRs. Default loopback. Nothing
# proxies the API today: clients reach the container's :8080 directly. Set it to the load balancer range if a
# proxy on another host ever fronts the API. A malformed value stops startup.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# The dashboard server (Vercel) sends every customer request from its own
# address. With this set, a request carrying X-Relay-BFF-Token equal to it may
# name the user's address in X-Relay-Client-IP, so the sign-in limit counts
# users rather than the dashboard. Random, at least 32 bytes
# (openssl rand -hex 32); the same value goes in the dashboard's environment.
# Empty ignores both headers. A shorter value stops startup.
BFF_CLIENT_IP_TOKEN=

# Abuse guard, on every API route except carrier webhooks and /healthz.
# An address over ABUSE_IP_PER_MINUTE is banned (15 min, then 1 h, 4 h, 24 h
# for repeat offences within a day). A credential (API key or session) over
# ABUSE_TOKEN_PER_MINUTE is refused for the rest of the minute, never banned.
# 0 turns either off. ABUSE_IGNORE_CIDRS (office, monitoring) are never limited.
# List and lift bans: operator-admin bans | operator-admin unban <ip>
ABUSE_IP_PER_MINUTE=1200
ABUSE_TOKEN_PER_MINUTE=6000
ABUSE_IGNORE_CIDRS=

# How a promotional SMS to an Indian number meets the do-not-disturb register
# (TRAI TCCCPR 2018):
#   deny     refuse every such message `dnd_check_unavailable`, at cost 0;
#   operator trust the operator's DLT scrubbing: never refuse, and explain its
#            DND rejection receipt as `dnd_blocked`;
#   ncpr     a register lookup (no client yet, so it refuses like deny).
# Stays deny until the operator confirms it scrubs our binds. Transactional and
# service traffic is never checked. Anything else stops the server.
DND_MODE=deny

# Countries whose SMS may link only to hosts on the tenant's approved list
# (Compliance > Approved links). India on; "none" turns the rule off.
APPROVED_LINK_COUNTRIES=IN

# The host a tenant's own short-link domain must CNAME to. Empty: no link domains.
LINK_DOMAIN_TARGET=

# Public base for tracked links and uploaded media: this server's API.
LINK_BASE_URL=http://189.72.144.98:8080
MEDIA_ROOT=/var/lib/relay/media
MEDIA_BASE_URL=http://189.72.144.98:8080
MEDIA_SIGNING_KEY=REPLACE
RCS_WEBHOOK_TOKEN=REPLACE
