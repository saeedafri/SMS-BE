# /etc/fail2ban/jail.d/relay.local
# Bans are firewall drops on 80/443, so a banned address costs nginx nothing.
# Never banned: this box, the old Hostinger proxy.

[DEFAULT]
ignoreip = 127.0.0.1/8 ::1 3.111.226.170 31.97.186.223

# 20 nginx rate-limit refusals in a minute: one hour.
[relay-nginx-flood]
enabled  = true
filter   = relay-nginx-flood
logpath  = /var/log/nginx/relay-access.json
backend  = auto
port     = http,https
maxretry = 20
findtime = 60
bantime  = 3600

# 60 missing paths in a minute: a scanner, one day.
[relay-nginx-scan]
enabled  = true
filter   = relay-nginx-scan
logpath  = /var/log/nginx/relay-access.json
backend  = auto
port     = http,https
maxretry = 60
findtime = 60
bantime  = 86400

# Banned three times in a day by any jail: one week.
[recidive]
enabled  = true
logpath  = /var/log/fail2ban.log
banaction = nftables-allports
bantime  = 604800
findtime = 86400
maxretry = 3
