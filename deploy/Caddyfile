# Caddy terminates TLS and gets certificates automatically.
# Replace the two domains, then: systemctl reload caddy

api.example.com {
	reverse_proxy 127.0.0.1:8080

	# The metrics endpoint carries no tenant data but does reveal route names
	# and timings, so it is not published to the internet. Reach it over the
	# SSH tunnel instead: ssh -L 8080:127.0.0.1:8080 root@HOST
	@internal path /metrics
	respond @internal 404

	encode gzip
	log {
		output file /var/log/caddy/api.log
		format json
	}
}

app.example.com {
	reverse_proxy 127.0.0.1:3000
	encode gzip
	log {
		output file /var/log/caddy/app.log
		format json
	}
}
