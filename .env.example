# Local development. Copy to .env — .env is gitignored.
#
# Two Postgres URLs per database on purpose:
#   *_URL       -> sms_app, the unprivileged role. Subject to row-level security.
#                  This is what the application uses.
#   *_ADMIN_URL -> superuser. Migrations and test fixtures only. Never the app.
DATABASE_URL=postgres://sms_app:sms_app_local@localhost:5432/sms_dev?sslmode=disable
DATABASE_ADMIN_URL=postgres://localhost:5432/sms_dev?sslmode=disable
TEST_DATABASE_URL=postgres://sms_app:sms_app_local@localhost:5432/sms_test?sslmode=disable
TEST_DATABASE_ADMIN_URL=postgres://localhost:5432/sms_test?sslmode=disable

REDIS_URL=redis://localhost:6379/0

# ClickHouse holds message logs and analytics from Stage 5.
# See docs/LOCAL_DEV.md — install with the official script, NOT Homebrew.
CLICKHOUSE_URL=http://localhost:8123/sms_dev
TEST_CLICKHOUSE_URL=http://localhost:8123/sms_test

CONTROL_API_ADDR=:8080
JWT_SIGNING_KEY=local-development-only-do-not-use-in-production
LOG_LEVEL=debug

# --- RCS carrier (optional) -------------------------------------------------
#
# Capability discovery — whether a handset can receive RCS, and which rich
# features it supports. Leave every line below unset and the API answers "no RCS
# carrier configured" rather than reporting every handset unreachable.
#
# Configure ONE carrier. Both sets present without RCS_VENDOR refuses to start,
# because the two answer the same question differently for the same handset and
# guessing would make the product's answer depend on nothing the operator chose.
# A half-configured carrier also refuses to start, and names the missing field.
#
# RCS_VENDOR=airtel

# Airtel IQ. AUTH_TOKEN is the base64 blob Airtel issues, used verbatim after
# "Basic " — it is not a username:password pair we encode ourselves. It never
# expires and is reset by emailing their support desk.
# RCS_AIRTEL_BASE_URL=https://iqconversation.airtel.in/gateway/airtel-xchange
# RCS_AIRTEL_AUTH_TOKEN=
# RCS_AIRTEL_AGENT_ID=
# Capability discovery does not need these two; template registration and send
# both refuse without them, so a deployment missing them can answer whether a
# handset is reachable and never send it anything.
# RCS_AIRTEL_CUSTOMER_ID=
# RCS_AIRTEL_SUBACCOUNT_ID=

# Vi RBM. Client credentials mint a short-lived token from a SEPARATE host, and
# that token endpoint allows only 60 requests a minute per client, so the token
# is cached in-process. BASE_URL takes no trailing /rcs — the capability path
# supplies its own and the bulk path does not use one.
# RCS_VI_BASE_URL=https://api.virbm.in
# RCS_VI_TOKEN_URL=https://auth.virbm.in/auth/oauth/token
# RCS_VI_CLIENT_ID=
# RCS_VI_CLIENT_SECRET=
# RCS_VI_BOT_ID=

# Carrier callbacks: delivery outcomes and template approvals.
#
# Without these nothing ever settles. Every RCS message sits in flight until the
# reconciler expires it and refunds a message that may well have arrived, and a
# template stays pending forever even after the carrier approves it. The API
# warns at boot when a carrier is configured and this is not.
#
# The secret travels in the PATH because neither vendor signs its callbacks and
# neither lets us attach a header:
#
#   https://api.example.com/v1/carrier-webhooks/rcs/airtel/<token>
#   https://api.example.com/v1/carrier-webhooks/rcs/vi/<token>
#
# That means it lands in access logs, so pair it with the allowlist below and
# rotate it by changing this one value. Empty leaves the routes unmounted.
# RCS_WEBHOOK_TOKEN=
#
# Addresses or CIDRs, comma separated. Airtel documents IP whitelisting in both
# directions; this is our half. Empty means no restriction.
# RCS_WEBHOOK_IP_ALLOWLIST=
