# Local development. Copy to .env — .env is gitignored.
#
# Two Postgres URLs per database on purpose:
#   *_URL       -> sms_app, the unprivileged role. Subject to row-level security.
#                  This is what the application uses.
#   *_ADMIN_URL -> superuser. Migrations and test fixtures only. Never the app.
DATABASE_URL=postgres://sms_app:sms_app_local@localhost:5432/sms_dev?sslmode=disable
DATABASE_ADMIN_URL=postgres://localhost:5432/sms_dev?sslmode=disable
TEST_DATABASE_URL=postgres://sms_app:sms_app_local@localhost:5432/sms_test?sslmode=disable
TEST_DATABASE_ADMIN_URL=postgres://localhost:5432/sms_test?sslmode=disable

REDIS_URL=redis://localhost:6379/0

# ClickHouse holds message logs and analytics from Stage 5.
# See docs/LOCAL_DEV.md — install with the official script, NOT Homebrew.
CLICKHOUSE_URL=http://localhost:8123/sms_dev
TEST_CLICKHOUSE_URL=http://localhost:8123/sms_test

CONTROL_API_ADDR=:8080
JWT_SIGNING_KEY=local-development-only-do-not-use-in-production
LOG_LEVEL=debug
